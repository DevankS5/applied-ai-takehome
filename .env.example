# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- LLM providers (both have free tiers) ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys

# --- Problem 1: RAG service ---
RAG_DB_PATH=data/lancedb
RAG_TABLE=chunks
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=400         # tokens
RAG_CHUNK_OVERLAP=60       # tokens
RAG_TOP_K=5
RAG_MIN_SCORE=0.55         # cosine-similarity floor for the no-context guard (calibrated in rag_eval)
RAG_GEN_PROVIDER=groq
RAG_GEN_MODEL=llama-3.3-70b-versatile
RAG_LOG_LEVEL=INFO

# --- Problem 2: LLM-as-judge (judge and generator configured independently) ---
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_TEMPERATURE=0
GENERATOR_PROVIDER=groq
GENERATOR_MODEL=llama-3.1-8b-instant
